<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #8ce4ff;
            display: flex;
            margin-top: 50px;
            justify-content: center;
        }
        .card {
            background-color: #ffffff;
            width: 300px;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
        }
        .card img {
            width: 100%;
            border-radius: 10px;
        }
        .preço {
            color: #ffffff;
            font-weight: bold;
            font-size: 18px;
        }

        .btn {
      background-color: #4f46e5;
      color: white;
      border: none; 
      padding: 12px 20px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      width: 100%;
        }

    button:hover{
        background-color: #3730a3;
    }
    </style>
</head>

<body>
    <div class="card">
        <img src="produto.avif" alt="iphone 32">

        <h2>Iphone 32</h2>
        <p>50gb de memória ram</p>
        <p>200tb de armazenamento</p>
        <p>50000mAh de bateria</p>
        
        <p class="preço"> R$ 119.999,99 </p>
        <button class="btn">Comprar</button>
    </div>
</body>

</html>
